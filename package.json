{
  "name": "cs2-nades-telegram-app",
  "version": "1.0.0",
  "description": "Telegram Mini App for CS2 grenade lineups",
  "main": "src/main.tsx",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "dev:server": "node -r dotenv/config server/server.ts dotenv:PORT=3000",
    "dev:client": "vite --host",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --mode production",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "test": "vitest"
  },
  "dependencies": {
    "@types/node": "^26.6.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-node": "^10.9.2",
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "dotenv": "^16.3.1",
    "axios": "^1.6.7",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.2.2",
    "typescript": "^5.9.3",
    "vite": "^4.4.0",
    "vitest": "^1.2.2"
  }
}
