FROM node:18
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN mkdir -p scripts
COPY scripts/healthcheck.js ./scripts/healthcheck.js
RUN npm run build:server
COPY server/db/migrations/001_initial.sql /app/dist/db/migrations/001_initial.sql
COPY server/db/migrations/002_telegram_video.sql /app/dist/db/migrations/002_telegram_video.sql
COPY server/db/migrations/003_map_selection.sql /app/dist/db/migrations/003_map_selection.sql
COPY server/db/seeds/001_maps.sql /app/dist/db/seeds/001_maps.sql
COPY server/db/seeds/002_lineups.sql /app/dist/db/seeds/002_lineups.sql
EXPOSE 3000
CMD ["node", "/app/dist/server.js"]